APP_ENV=dev
APP_DEBUG=1
APP_SECRET=
# Injectées par Docker Compose avec le rôle PostgreSQL limité de l’application.
DATABASE_HOST=database
DATABASE_NAME=benevole_jambville
DATABASE_TEST_NAME=benevole_jambville_test
DATABASE_USER=benevole_jambville_app
DATABASE_PASSWORD=

# Utilisées uniquement par le Compose Symfony autonome de ce sous-dossier.
POSTGRES_VERSION=18-alpine
POSTGRES_IMAGE_DIGEST=sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
POSTGRES_DB=benevole_jambville
POSTGRES_USER=benevole_jambville
POSTGRES_PASSWORD=

###> symfony/framework-bundle ###
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8081
TRUSTED_HOST_PATTERN=^(localhost|127[.]0[.]0[.]1)$
TRUSTED_PROXIES=127.0.0.1
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=no-reply@example.com
###< symfony/mailer ###
