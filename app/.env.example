APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me
APP_VERSION=0.2
# Injectées par Docker Compose avec le rôle PostgreSQL limité de l’application.
DATABASE_HOST=database
DATABASE_NAME=benevole_jambville
DATABASE_TEST_NAME=benevole_jambville_test
DATABASE_USER=benevole_jambville_app
DATABASE_PASSWORD=change-me

###> symfony/framework-bundle ###
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
TRUSTED_PROXIES=127.0.0.1,private_ranges
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=no-reply@example.com
###< symfony/mailer ###
