{% extends 'base.html.twig' %}

{% block title %}{{ profilAdmin ? utilisateurProfil.nomComplet : 'Mon profil' }} · Bénévoles Jambville{% endblock %}

{% block body %}
<div class="application">
    {% include 'commun/_barre_application.html.twig' %}

    <main class="page-profil">
        {% if profilAdmin %}
            <a class="retour-calendrier" href="{{ path('app_accueil') }}">← Retour au calendrier</a>
        {% elseif app.user.roleMetier == 'BENEVOLE' %}
            <a class="retour-calendrier" href="{{ path('app_accueil') }}">← Retour au calendrier</a>
        {% endif %}

        <header class="entete-profil">
            <h1>{{ profilAdmin ? utilisateurProfil.nomComplet : 'Mon profil' }}</h1>
            <p>{{ profilAdmin ? 'Consultez et mettez à jour les informations de ce bénévole.' : 'Gardez à jour les informations utiles à votre accueil à Jambville.' }}</p>
        </header>

        {% for message in app.flashes('succes') %}<div class="alerte alerte-succes">{{ message }}</div>{% endfor %}
        {% if erreurs %}<div class="alerte alerte-erreur"><ul>{% for erreur in erreurs %}<li>{{ erreur }}</li>{% endfor %}</ul></div>{% endif %}

        <form class="formulaire-profil" method="post" action="{{ actionProfil }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token(profilAdmin ? 'modifier-profil-' ~ utilisateurProfil.id : 'modifier-profil') }}">

            <section class="carte-profil" aria-labelledby="identite-titre">
                <header><h2 id="identite-titre">Identité</h2><p>Ces informations proviennent de votre dossier adhérent et ne sont pas modifiables ici.</p></header>
                <div class="grille-profil">
                    <div class="champ"><label for="prenom">Prénom</label><input id="prenom" value="{{ utilisateurProfil.prenom }}" readonly></div>
                    <div class="champ"><label for="nom">Nom</label><input id="nom" value="{{ utilisateurProfil.nom }}" readonly></div>
                    <div class="champ"><label for="email">Email</label><input id="email" type="email" value="{{ utilisateurProfil.email }}" readonly></div>
                    <div class="champ">
                        <label for="telephone">Téléphone</label>
                        <input id="telephone" name="telephone" type="tel" maxlength="30" value="{{ app.request.request.get('telephone', utilisateurProfil.telephone) }}" autocomplete="tel" inputmode="tel" aria-describedby="erreur-telephone" data-telephone-francais>
                        <small id="erreur-telephone" class="erreur-champ" data-erreur-telephone hidden>Indiquez un numéro français valide, par exemple 06 12 34 56 78.</small>
                    </div>
                </div>
            </section>

            {% if profilAdmin %}
            <section class="carte-profil" aria-labelledby="role-titre">
                <header><h2 id="role-titre">Rôle</h2><p>Le rôle détermine les espaces et les fonctionnalités accessibles à cette personne.</p></header>
                <div class="champ">
                    <label for="role">Rôle de la personne</label>
                    {% set roleSelectionne = app.request.isMethod('POST') ? app.request.request.get('role') : utilisateurProfil.roleMetier %}
                    <select id="role" name="role" required>
                        <option value="BENEVOLE" {{ roleSelectionne == 'BENEVOLE' ? 'selected' }}>Bénévole</option>
                        <option value="EQUIPE_PILOTE" {{ roleSelectionne == 'EQUIPE_PILOTE' ? 'selected' }}>Équipe pilote</option>
                        <option value="SALARIE_ACCUEIL" {{ roleSelectionne == 'SALARIE_ACCUEIL' ? 'selected' }}>Salarié</option>
                    </select>
                </div>
            </section>
            {% endif %}

            <section class="carte-profil" aria-labelledby="alimentation-titre">
                <header><h2 id="alimentation-titre">Régime et allergies alimentaires</h2><p>Ces informations sensibles servent uniquement à préparer votre accueil et vos repas.</p></header>
                <div class="choix-profil">
                    <label><input type="checkbox" name="vegetarien" value="1" {{ (app.request.isMethod('POST') ? app.request.request.getBoolean('vegetarien') : utilisateurProfil.vegetarien) ? 'checked' }}> Régime végétarien</label>
                    <label><input type="checkbox" name="allergie_oeuf" value="1" {{ (app.request.isMethod('POST') ? app.request.request.getBoolean('allergie_oeuf') : utilisateurProfil.allergieOeuf) ? 'checked' }}> Allergie aux œufs</label>
                    <label><input type="checkbox" name="allergie_arachide" value="1" {{ (app.request.isMethod('POST') ? app.request.request.getBoolean('allergie_arachide') : utilisateurProfil.allergieArachide) ? 'checked' }}> Allergie aux arachides</label>
                </div>
                <div class="champ"><label for="regime_autre">Autre régime ou allergie alimentaire</label><textarea id="regime_autre" name="regime_autre" rows="3" placeholder="Précisez toute autre contrainte alimentaire">{{ app.request.request.get('regime_autre', utilisateurProfil.regimeAutre) }}</textarea></div>
            </section>

            <section class="carte-profil" aria-labelledby="couchage-titre">
                <header><h2 id="couchage-titre">Couchage</h2><p>Signalez ici les besoins à anticiper pour votre hébergement.</p></header>
                <div class="champ"><label for="besoin_couchage">Besoin spécifique de couchage</label><textarea id="besoin_couchage" name="besoin_couchage" rows="3" placeholder="Accessibilité, matériel ou autre besoin particulier">{{ app.request.request.get('besoin_couchage', utilisateurProfil.besoinCouchage) }}</textarea></div>
            </section>

            {% if app.user.equipePilote %}
            <section class="carte-profil" aria-labelledby="equipement-titre">
                <header><h2 id="equipement-titre">Équipement bénévole</h2><p>Vous pouvez mettre à jour la remise de votre équipement.</p></header>
                <div class="choix-profil">
                    <label><input type="checkbox" name="foulard_remis" value="1" {{ utilisateurProfil.foulardRemis ? 'checked' }}> Foulard remis</label>
                    <label><input type="checkbox" name="tenue_remise" value="1" {{ utilisateurProfil.tenueRemise ? 'checked' }}> Tenue remise</label>
                </div>
            </section>
            {% endif %}

            {% if not profilAdmin %}<section class="carte-profil" aria-labelledby="mot-de-passe-titre">
                <header><h2 id="mot-de-passe-titre">Mot de passe</h2><p>Laissez ces champs vides si vous ne souhaitez pas modifier votre mot de passe.</p></header>
                <div class="grille-profil">
                    <div class="champ champ-large">
                        <label for="mot_de_passe_actuel">Mot de passe actuel</label>
                        <input id="mot_de_passe_actuel" name="mot_de_passe_actuel" type="password" autocomplete="current-password">
                    </div>
                    <div class="champ">
                        <label for="nouveau_mot_de_passe">Nouveau mot de passe</label>
                        <input id="nouveau_mot_de_passe" name="nouveau_mot_de_passe" type="password" minlength="12" autocomplete="new-password">
                        <small>Utilisez au moins 12 caractères.</small>
                    </div>
                    <div class="champ">
                        <label for="confirmation_mot_de_passe">Confirmer le nouveau mot de passe</label>
                        <input id="confirmation_mot_de_passe" name="confirmation_mot_de_passe" type="password" minlength="12" autocomplete="new-password">
                    </div>
                </div>
            </section>{% endif %}

            <div class="actions-formulaire"><a class="bouton-secondaire" href="{{ profilAdmin ? path('app_admin_benevoles') : path('app_accueil') }}">Annuler</a><button class="bouton-principal" type="submit">{{ profilAdmin ? 'Enregistrer le profil' : 'Enregistrer mon profil' }}</button></div>
        </form>
    </main>
</div>
{% endblock %}
