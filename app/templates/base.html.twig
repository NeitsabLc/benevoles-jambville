<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Bénévoles Jambville{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block javascripts %}
        {% set nonce_csp = app.request.server.get('CSP_NONCE')|default('nonce-hors-proxy', true) %}
        {% block importmap %}{{ importmap('app', {nonce: nonce_csp}) }}{% endblock %}
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% block body %}{% endblock %}
    <footer class="pied-page-legal{{ app.user and app.user.roleMetier != 'BENEVOLE' ? ' pied-page-legal--avec-navigation' : '' }}">
        <span>Version {{ version_application }}</span>
        <span aria-hidden="true">—</span>
        <a href="{{ path('app_conditions_utilisation') }}">Conditions d’utilisation</a>
        <span aria-hidden="true">—</span>
        <a href="{{ path('app_politique_confidentialite') }}">Politique de confidentialité</a>
    </footer>
</body>
</html>
