<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Bénévoles Jambville{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% block body %}{% endblock %}
    <footer class="pied-page-legal">
        <span>Bénévoles Jambville</span><span aria-hidden="true">—</span>
        <a href="{{ path('app_conditions_utilisation') }}">Conditions d’utilisation</a><span aria-hidden="true">—</span>
        <a href="{{ path('app_politique_confidentialite') }}">Politique de confidentialité</a>
    </footer>
</body>
</html>
