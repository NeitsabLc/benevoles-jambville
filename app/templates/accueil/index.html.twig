{% extends 'base.html.twig' %}

{% block title %}Calendrier des présences · Bénévoles Jambville{% endblock %}

{% block body %}
<div class="application">
    {% include 'commun/_barre_application.html.twig' %}

    <main class="contenu-calendrier">
        {% for message in app.flashes('succes') %}<div class="alerte alerte-succes">{{ message }}</div>{% endfor %}
        <section class="entete-calendrier">
            <h1>Qui sera à Jambville&nbsp;?</h1>
            {% if app.user.roleMetier != 'SALARIE_ACCUEIL' %}
                <a class="bouton-principal" href="{{ path('app_presence_ajouter') }}">
                    + {{ is_granted('ROLE_EQUIPE_PILOTE') ? 'Ajouter une présence' : 'Ajouter ma présence' }}
                </a>
            {% endif %}
        </section>

        {% if prochain_sejour %}
            <section class="carte-prochain-sejour" aria-labelledby="titre-prochain-sejour">
                <header class="entete-prochain-sejour">
                    <div>
                        <p class="sur-titre-prochain-sejour">Votre prochain séjour</p>
                        <h2 id="titre-prochain-sejour">{{ prochain_sejour.periode }}</h2>
                        {% if prochain_sejour.thematique %}
                            <p class="thematique-prochain-sejour">{{ prochain_sejour.thematique }}</p>
                        {% endif %}
                    </div>
                    <span class="statut-prochain-sejour">{{ prochain_sejour.statut }}</span>
                </header>

                <div class="corps-prochain-sejour {{ prochain_sejour.rooming ? 'corps-prochain-sejour--avec-rooming' }}">
                    <ol class="frise-prochain-sejour">
                        {% for jour in prochain_sejour.jours %}
                            <li class="jour-prochain-sejour">
                                <span class="repere-prochain-sejour" aria-hidden="true"><i></i></span>
                                <div class="detail-jour-prochain-sejour">
                                    <time datetime="{{ jour.date|date('Y-m-d') }}">
                                        <strong>{{ jour.jour }}</strong>
                                        <span>{{ jour.date_courte }}</span>
                                    </time>
                                    <div class="pastilles-prochain-sejour">
                                        {% if jour.arrivee %}<span class="pastille-sejour pastille-arrivee">Arrivée</span>{% endif %}
                                        {% for repas in jour.repas %}<span class="pastille-sejour pastille-repas">{{ repas }}</span>{% endfor %}
                                        {% if jour.repas is empty %}<span class="aucun-repas-sejour">Aucun repas</span>{% endif %}
                                        {% if jour.depart %}<span class="pastille-sejour pastille-depart">Départ</span>{% endif %}
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ol>

                    {% if prochain_sejour.rooming %}
                        <aside class="rooming-prochain-sejour" aria-label="Hébergement prévu">
                            <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24"><path d="M3 19V8m0 8h18v3M7 16v-5h5c2 0 3 1 3 3v2m0-4h3a3 3 0 0 1 3 3v1M5.5 8.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
                            <p class="libelle-rooming-prochain-sejour">Votre chambre</p>
                            {% for affectation in prochain_sejour.rooming %}
                                <div class="affectation-prochain-sejour">
                                    <strong>{{ affectation.nom }}</strong>
                                    <span>{{ affectation.batiment }}</span>
                                    <small>{{ affectation.periode }}</small>
                                </div>
                            {% endfor %}
                        </aside>
                    {% endif %}
                </div>

                <footer class="actions-prochain-sejour">
                    <a href="{{ path('app_presence_modifier', {id: prochain_sejour.id}) }}">Modifier mon séjour <span aria-hidden="true">→</span></a>
                </footer>
            </section>
        {% endif %}

        <section class="outils-calendrier" aria-label="Navigation du calendrier">
            <div class="filtre-et-legende-calendrier">
                <form method="get" action="{{ path('app_accueil') }}">
                    <input type="hidden" name="mois" value="{{ mois|date('Y-m') }}">
                    <select name="filtre" aria-label="Filtrer les présences" data-soumission-automatique>
                        <option value="">Toutes les présences</option>
                        <option value="compa" {{ filtre == 'compa' ? 'selected' }}>Compas</option>
                        {% for thematique in thematiques %}
                            <option value="{{ thematique.id }}" {{ filtre == thematique.id ? 'selected' }}>{{ thematique.nom }}</option>
                        {% endfor %}
                    </select>
                </form>
                <div class="legende-calendrier">
                    <span><i class="presence-moi"></i>Ma présence</span>
                    <span><i class="presence-autre"></i>Autres présences</span>
                </div>
            </div>
            <nav class="navigation-mois" aria-label="Changer de mois">
                <a href="{{ path('app_accueil', {mois: mois_precedent, filtre: filtre}) }}" aria-label="Mois précédent">‹</a>
                <strong>{{ libelle_mois }}</strong>
                <a href="{{ path('app_accueil', {mois: mois_suivant, filtre: filtre}) }}" aria-label="Mois suivant">›</a>
            </nav>
        </section>

        {% if filtre and nombre_presences == 0 %}
            <p class="etat-vide-filtre">
                {% if filtre == 'compa' %}
                    Aucune équipe compa n’est présente ce mois-ci.
                {% else %}
                    Aucune présence ne correspond à cette thématique ce mois-ci.
                {% endif %}
            </p>
        {% endif %}

        <section class="calendrier" aria-label="Présences en {{ libelle_mois }}">
            <div class="jours-semaine" aria-hidden="true"><span>Lun</span><span>Mar</span><span>Mer</span><span>Jeu</span><span>Ven</span><span>Sam</span><span>Dim</span></div>
            <div class="grille-calendrier">
                {% for jour in jours %}
                    <article class="jour-calendrier {{ not jour.dans_mois ? 'jour-hors-mois' }}">
                        <header class="entete-jour">
                            <time datetime="{{ jour.date|date('Y-m-d') }}">{{ jour.date|date('j') }}</time>
                            {% if jour.journee and jour.journee.personnePermanence %}<strong>{{ jour.journee.personnePermanence.nom|split(' ')|first }}</strong>{% endif %}
                        </header>
                        {% if jour.journee and jour.journee.commentaire %}<p class="commentaire-jour" title="{{ jour.journee.commentaire }}">{{ jour.journee.commentaire }}</p>{% endif %}
                        <div class="presences-jour">
                            {% for presence in jour.presences|slice(0, 3) %}
                                <div class="presence-apercu {{ loop.index == 3 ? 'presence-apercu-troisieme' }}">
                                    {% include 'accueil/_ligne_presence.html.twig' with {presence: presence} only %}
                                </div>
                            {% endfor %}
                            {% if jour.nombre_inscriptions > 3 %}
                                <button class="bouton-details-jour bouton-details-jour-bureau" type="button" aria-haspopup="dialog" aria-controls="details-jour-{{ jour.date|date('Y-m-d') }}" data-ouvrir-details-jour="details-jour-{{ jour.date|date('Y-m-d') }}">Voir les {{ jour.nombre_inscriptions - 3 }} autre{{ jour.nombre_inscriptions - 3 > 1 ? 's' : '' }}</button>
                            {% endif %}
                            {% if jour.nombre_inscriptions > 2 %}
                                <button class="bouton-details-jour bouton-details-jour-mobile" type="button" aria-haspopup="dialog" aria-controls="details-jour-{{ jour.date|date('Y-m-d') }}" data-ouvrir-details-jour="details-jour-{{ jour.date|date('Y-m-d') }}">Voir les {{ jour.nombre_inscriptions - 2 }} autre{{ jour.nombre_inscriptions - 2 > 1 ? 's' : '' }}</button>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>

        {% for jour in jours|filter(jour => jour.nombre_inscriptions > 2) %}
            <dialog class="dialog-details-jour" id="details-jour-{{ jour.date|date('Y-m-d') }}" data-dialog-details-jour>
                <section aria-labelledby="titre-details-jour-{{ jour.date|date('Y-m-d') }}">
                    <header class="entete-details-jour">
                        <div>
                            <h2 id="titre-details-jour-{{ jour.date|date('Y-m-d') }}">Présences du {{ jour.date|date('d/m/Y') }}</h2>
                            <p>{{ jour.effectif_total }} personne{{ jour.effectif_total > 1 ? 's' : '' }} · {{ jour.nombre_inscriptions }} inscription{{ jour.nombre_inscriptions > 1 ? 's' : '' }}</p>
                        </div>
                        <button type="button" class="fermer-details-jour" aria-label="Fermer le détail des présences" data-fermer-details-jour>×</button>
                    </header>
                    <div class="liste-details-jour">
                        {% for presence in jour.presences %}
                            {% include 'accueil/_ligne_presence.html.twig' with {presence: presence} only %}
                        {% endfor %}
                    </div>
                </section>
            </dialog>
        {% endfor %}

        <dialog class="dialog-suppression-presence" data-dialog-suppression-presence>
            <section aria-labelledby="titre-suppression-presence">
                <div class="icone-suppression-presence" aria-hidden="true">!</div>
                <h2 id="titre-suppression-presence">Supprimer cette présence&nbsp;?</h2>
                <p>La présence de <strong data-nom-suppression-presence></strong>, <span data-periode-suppression-presence></span>, ne sera plus affichée dans le calendrier.</p>
                <p class="avertissement-suppression-presence">Elle ne sera plus comptabilisée dans les repas et l’hébergement.</p>
                <form method="post" data-form-suppression-presence><input type="hidden" name="_csrf_token" data-token-suppression-presence><div class="actions-dialog-suppression"><button class="annuler-suppression-presence" type="button" data-fermer-suppression-presence>Annuler</button><button class="confirmer-suppression-presence" type="submit">Supprimer la présence</button></div></form>
            </section>
        </dialog>

    </main>
</div>
{% endblock %}
