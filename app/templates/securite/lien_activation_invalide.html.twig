{% extends 'base.html.twig' %}

{% block title %}Lien expiré · Bénévoles Jambville{% endblock %}

{% block body %}
<main class="page-authentification page-centree">
    <section class="panneau-authentification" aria-labelledby="titre-lien-invalide">
        {% include 'securite/_identite.html.twig' %}
        <div class="entete-formulaire">
            <p class="surtitre">Première connexion</p>
            <h1 id="titre-lien-invalide">Ce lien n’est plus valide</h1>
            <p>Il a peut-être expiré ou déjà été utilisé. Demandez un nouveau lien à l’équipe de Jambville.</p>
        </div>
        <a class="bouton-principal" href="{{ path('app_connexion') }}">Revenir à la connexion</a>
    </section>
</main>
{% endblock %}
