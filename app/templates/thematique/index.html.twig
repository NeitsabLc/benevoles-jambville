{% extends 'base.html.twig' %}
{% block title %}Thématiques · Bénévoles Jambville{% endblock %}
{% block body %}<div class="application">{% include 'commun/_barre_application.html.twig' %}
<main class="page-thematiques">
    <header class="entete-thematiques entete-liste-thematiques"><div><h1>Thématiques</h1><p>Gérez les choix proposés lors de l’inscription des bénévoles.</p></div><a class="bouton-principal bouton-ajouter-thematique" href="{{ path('app_admin_thematique_ajouter') }}" aria-label="Ajouter une thématique"><span aria-hidden="true">＋</span><span class="libelle-ajout-thematique">Ajouter une thématique</span></a></header>
    {% for message in app.flashes('succes') %}<div class="alerte alerte-succes">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('erreur') %}<div class="alerte alerte-erreur">{{ message }}</div>{% endfor %}
    <section class="carte-liste-thematiques" aria-label="Thématiques existantes"><header class="resume-thematiques"><p>{{ thematiques|length }} thématique{{ thematiques|length > 1 ? 's' }}</p></header><div class="liste-thematiques">
        {% for thematique in thematiques %}<div class="glissiere-thematique" data-glissiere-thematique><form class="action-glissee-thematique {{ not thematique.actif ? 'reactiver' }}" method="post" action="{{ path('app_admin_thematique_activation', {id: thematique.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('activation-thematique-' ~ thematique.id) }}"><button type="submit">{{ thematique.actif ? 'Désactiver' : 'Réactiver' }}</button></form><article class="ligne-thematique {{ not thematique.actif ? 'inactive' }}" tabindex="0" role="link" data-carte-thematique data-modification-url="{{ path('app_admin_thematique_modifier', {id: thematique.id}) }}">
            <div class="contenu-thematique"><h2>{{ thematique.nom }}</h2><p>{% if thematique.evenement %}<strong>Événement</strong> · du {{ thematique.dateDebutEvenement|date('d/m/Y') }} au {{ thematique.dateFinEvenement|date('d/m/Y') }}{% if thematique.exclusiveSurPeriode %} · <span>Exclusive</span>{% endif %}{% else %}Thématique permanente{% endif %}</p></div><div class="colonne-statut-thematique"><span class="statut-thematique">{{ thematique.actif ? 'Active' : 'Inactive' }}</span></div>
            <div class="actions-thematique"><a class="bouton-modifier-thematique" href="{{ path('app_admin_thematique_modifier', {id: thematique.id}) }}" aria-label="Modifier {{ thematique.nom }}" title="Modifier"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z"/></svg></a><form method="post" action="{{ path('app_admin_thematique_activation', {id: thematique.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('activation-thematique-' ~ thematique.id) }}"><button type="submit" class="bouton-activation-thematique {{ not thematique.actif ? 'reactiver' }}" aria-label="{{ thematique.actif ? 'Désactiver' : 'Réactiver' }} {{ thematique.nom }}" title="{{ thematique.actif ? 'Désactiver' : 'Réactiver' }}">{% if thematique.actif %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5"/></svg>{% else %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v9m-5.7-6.3a8 8 0 1 0 11.4 0"/></svg>{% endif %}</button></form></div>
        </article></div>{% else %}<p>Aucune thématique.</p>{% endfor %}
    </div></section>
</main></div>{% endblock %}
