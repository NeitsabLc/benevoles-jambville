{% extends 'base.html.twig' %}
{% block title %}Modifier {{ thematique.nom }} · Bénévoles Jambville{% endblock %}
{% block body %}<div class="application">{% include 'commun/_barre_application.html.twig' %}
<main class="page-thematiques page-formulaire-thematique"><nav class="fil-ariane-thematique" aria-label="Fil d’Ariane"><a href="{{ path('app_admin_thematiques') }}">Thématiques</a><span>/</span><span>{{ thematique.nom }}</span></nav><header class="entete-thematiques"><h1>{{ thematique.nom }}</h1><p>Modifiez les informations et les règles de disponibilité de cette thématique.</p></header>{% for message in app.flashes('erreur') %}<div class="alerte alerte-erreur">{{ message }}</div>{% endfor %}
<form method="post" class="formulaire-thematique"><section class="carte-thematique"><h2>Informations générales</h2><input type="hidden" name="_csrf_token" value="{{ csrf_token('modifier-thematique-' ~ thematique.id) }}">{% include 'thematique/_formulaire.html.twig' %}</section><div class="actions-formulaire actions-thematique-formulaire"><a class="bouton-secondaire" href="{{ path('app_admin_thematiques') }}">Annuler</a><button class="bouton-principal" type="submit">Enregistrer les modifications</button></div></form></main></div>{% endblock %}
