{% extends 'base.html.twig' %}

{% block title %}{{ titre }} · Bénévoles Jambville{% endblock %}

{% block body %}
<div class="application">
    {% include 'commun/_barre_application.html.twig' %}
    <main class="page-future">
        <header>
            <p class="surtitre">{{ surtitre }}</p>
            <h1>{{ titre }}</h1>
        </header>
        <section class="carte-future">
            <span aria-hidden="true">BJ</span>
            <h2>Page en préparation</h2>
            <p>{{ message }}</p>
            <a class="bouton-secondaire" href="{{ path('app_accueil') }}">Retour au calendrier</a>
        </section>
    </main>
</div>
{% endblock %}
