{% extends 'base.html.twig' %}

{% block title %}Synthèse des inscriptions · Bénévoles Jambville{% endblock %}

{% block body %}
<div class="application">
    {% include 'commun/_barre_application.html.twig' %}
    <main class="page-synthese">
        <header class="entete-synthese">
            <div><h1>Synthèse des inscriptions</h1><p>Repas, couchages et régimes alimentaires, jour par jour.</p></div>
        </header>

        <form class="filtre-synthese" method="get" action="{{ path('app_synthese') }}">
            <div class="champ"><label for="synthese-debut">Du</label><input id="synthese-debut" type="date" name="debut" value="{{ debut|date('Y-m-d') }}" required></div>
            <div class="champ"><label for="synthese-fin">Au</label><input id="synthese-fin" type="date" name="fin" value="{{ fin|date('Y-m-d') }}" required></div>
            <button class="bouton-principal" type="submit">Afficher la période</button>
        </form>
        {% if erreur %}<div class="alerte alerte-erreur">{{ erreur }}</div>{% endif %}

        <div class="liste-synthese">
            {% for jour in jours %}
                {% set total = jour.presences|reduce((total, presence) => total + presence.effectif, 0) %}
                {% set nombre_inscriptions = jour.presences|length %}
                <article class="jour-synthese">
                    <header class="date-synthese">
                        <time datetime="{{ jour.date|date('Y-m-d') }}"><strong>{{ jour.libelle_date }}</strong><span>{{ total }} personne{{ total > 1 ? 's' }}{% if nombre_inscriptions > 0 %} · {{ nombre_inscriptions }} inscription{{ nombre_inscriptions > 1 ? 's' }}{% endif %}</span></time>
                    </header>
                    <section class="repas-synthese" aria-label="Repas">
                        <div><span>Petit-déjeuner</span><strong>{{ jour.repas.PETIT_DEJEUNER }}</strong></div>
                        <div><span>Déjeuner</span><strong>{{ jour.repas.DEJEUNER }}</strong></div>
                        <div><span>Dîner</span><strong>{{ jour.repas.DINER }}</strong></div>
                    </section>
                    <section class="details-synthese">
                        <div class="presences-synthese">
                            <h2>Présences {% if nombre_inscriptions > 0 %}<b>{{ nombre_inscriptions }}</b>{% endif %}</h2>
                            {% if nombre_inscriptions == 0 %}
                                <p class="donnee-vide">Aucune présence</p>
                            {% else %}
                                {% if nombre_inscriptions > 5 %}
                                    <div class="apercu-presences-synthese">
                                        {% for presence in jour.presences|slice(0, 5) %}<span class="pastille-presence">{{ presence.libelle }}{% if presence.est_equipe %} · {{ presence.effectif }}{% endif %}</span>{% endfor %}
                                    </div>
                                    <details class="details-presences-synthese">
                                        <summary><span class="libelle-details-ferme">Voir les {{ nombre_inscriptions - 5 }} autre{{ nombre_inscriptions - 5 > 1 ? 's' : '' }} inscription{{ nombre_inscriptions - 5 > 1 ? 's' : '' }}</span><span class="libelle-details-ouvert">Replier le détail</span></summary>
                                        {% include 'espace_prive/_table_presences_synthese.html.twig' with {presences: jour.presences} only %}
                                    </details>
                                {% else %}
                                    {% include 'espace_prive/_table_presences_synthese.html.twig' with {presences: jour.presences} only %}
                                {% endif %}
                            {% endif %}
                        </div>
                        {% for type, couchage in jour.couchages %}
                            <div class="resume-couchage-synthese"><h2>{{ type == 'DUR' ? 'En dur' : 'En tente' }} <b>{{ couchage.total }}</b></h2><p>{{ couchage.presences|length }} inscription{{ couchage.presences|length > 1 ? 's' : '' }}</p></div>
                        {% endfor %}
                        <div class="regimes-synthese">
                            <h2>Régimes</h2>
                            <dl><div><dt>Végétariens</dt><dd>{{ jour.regimes.vegetariens }}</dd></div><div><dt>Sans lactose</dt><dd>{{ jour.regimes.sans_lactose }}</dd></div><div><dt>Sans gluten</dt><dd>{{ jour.regimes.sans_gluten }}</dd></div></dl>
                            {% if jour.regimes.commentaires %}
                                <section class="commentaires-regimes" aria-label="Autres allergies et régimes signalés">
                                    <h3>Autres signalés</h3>
                                    <ul>{% for commentaire in jour.regimes.commentaires %}<li>{{ commentaire }}</li>{% endfor %}</ul>
                                </section>
                            {% endif %}
                        </div>
                    </section>
                </article>
            {% endfor %}
        </div>
    </main>
</div>
{% endblock %}
