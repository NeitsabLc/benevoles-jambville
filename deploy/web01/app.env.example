# Copier ce fichier vers app/.env sur web01, propriétaire du compte de
# déploiement, groupe www-data, mode 0640.
APP_ENV=prod
APP_SECRET=

# Ces valeurs sont remplacées par Compose. Elles documentent le contrat de
# configuration de Symfony et permettent aussi les commandes hors Compose.
DATABASE_HOST=database
DATABASE_NAME=benevole_jambville
DATABASE_TEST_NAME=benevole_jambville_test
DATABASE_USER=benevole_jambville_app
DATABASE_PASSWORD=

APP_SHARE_DIR=var/share
DEFAULT_URI=https://benevoles-jambville.neitsab.net
TRUSTED_HOST_PATTERN=^benevoles-jambville[.]neitsab[.]net$
TRUSTED_PROXIES=192.168.2.6

# Renseigner un transport SMTP réel avant la production.
MAILER_DSN=
MAILER_FROM=no-reply@neitsab.net
