# Copier ce fichier vers .env à la racine du dépôt sur web01.
# Ne jamais renseigner de secret dans cette copie versionnée.
COMPOSE_PROJECT_NAME=benevole_jambville

PHP_VERSION=8.4
PHP_IMAGE_DIGEST=sha256:9467f10bf42897dec0abb73ee20c747ebd45463ec9d6fcc4044cb83eba6dade7
COMPOSER_IMAGE_DIGEST=sha256:4d71c3c2109c61d5415544264b59ad4087e4c5b7244481723664138fd36d5040
NGINX_VERSION=1.30.4-alpine
NGINX_IMAGE_DIGEST=sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46

# Le port HTTP n'écoute que sur l'adresse LAN de web01. Le pare-feu doit
# autoriser sa connexion uniquement depuis proxy01 (192.168.2.6).
NGINX_BIND_ADDRESS=192.168.2.18
NGINX_HOST_PORT=8081
APP_HOSTNAME=benevoles-jambville.neitsab.net

POSTGRES_VERSION=18-alpine
POSTGRES_IMAGE_DIGEST=sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
POSTGRES_DB=benevole_jambville
POSTGRES_USER=benevole_jambville
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_BACKUP_PASSWORD=
POSTGRES_HEALTHCHECK_USER=benevole_jambville_admin
POSTGRES_HEALTHCHECK_PASSWORD=
POSTGRES_HBA_FILE=./docker/postgres/pg_hba.prod.conf.example
BENEVOLE_NETWORK_SUBNET=172.29.0.0/24

# Répertoire persistant appartenant à l'UID/GID 70 (postgres dans l'image).
BACKUP_DIR=/srv/backups/benevole-jambville
BACKUP_AGE_RECIPIENT=age1remplacer-par-la-cle-publique-de-sauvegarde
AGE_PACKAGE_VERSION=1.3.1-r5

LIQUIBASE_VERSION=5.0.1
LIQUIBASE_IMAGE_DIGEST=sha256:ec5b6ef176df3b39d69a67af728dbe0baa39ccae42da94e0ca397ef0dfe9cedb
PGJDBC_VERSION=42.7.12
PGJDBC_SHA256=31fbf6f06b2217fb51d5100cee51b22625cc81640da0679b47914e54c1e6377c

TRUSTED_HOST_PATTERN=^benevoles-jambville[.]neitsab[.]net$
TRUSTED_PROXIES=192.168.2.6
